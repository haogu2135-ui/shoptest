[Unit]
Description=Shoptest Spring Boot API (local runtime)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/guhao/shoptest
Environment=SHOPTEST_BACKEND_ENV_FILE=/etc/shoptest/backend.env
Environment=SHOPTEST_BACKEND_JAR=/home/guhao/shoptest/target/shop-0.0.1-SNAPSHOT.jar
ExecStart=/home/guhao/shoptest/scripts/run-shoptest-backend.sh
Restart=always
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

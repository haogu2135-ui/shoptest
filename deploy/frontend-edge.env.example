SERVER_NAME=petsanything.com
CANONICAL_SERVER_NAME=petsanything.com
CANONICAL_REDIRECT_NAMES=www.petsanything.com
HTTPS_LISTEN_PORT=443
SSL_CERTIFICATE=/etc/nginx/ssl/petsanything.com.crt
SSL_CERTIFICATE_KEY=/etc/nginx/ssl/petsanything.com.key
SSL_CERTIFICATE_HOST_PATH=/etc/letsencrypt/live/petsanything.com/fullchain.pem
SSL_CERTIFICATE_KEY_HOST_PATH=/etc/letsencrypt/live/petsanything.com/privkey.pem
SWITCHER_SERVER_NAME=switch.686888666.xyz
SWITCHER_SSL_CERTIFICATE=/etc/nginx/ssl/switch.686888666.xyz.crt
SWITCHER_SSL_CERTIFICATE_KEY=/etc/nginx/ssl/switch.686888666.xyz.key
SWITCHER_SSL_CERTIFICATE_HOST_PATH=/etc/letsencrypt/live/switch.686888666.xyz/fullchain.pem
SWITCHER_SSL_CERTIFICATE_KEY_HOST_PATH=/etc/letsencrypt/live/switch.686888666.xyz/privkey.pem
F2B_SERVER_NAME=fail2ban.686888666.xyz
F2B_DASHBOARD_PORT=8790
F2B_SSL_CERTIFICATE=/etc/nginx/ssl/fail2ban.686888666.xyz.crt
F2B_SSL_CERTIFICATE_KEY=/etc/nginx/ssl/fail2ban.686888666.xyz.key
F2B_SSL_CERTIFICATE_HOST_PATH=/etc/letsencrypt/live/fail2ban.686888666.xyz/fullchain.pem
F2B_SSL_CERTIFICATE_KEY_HOST_PATH=/etc/letsencrypt/live/fail2ban.686888666.xyz/privkey.pem
F2B_AUTH_FILE=/etc/nginx/fail2ban-dashboard.htpasswd
F2B_AUTH_FILE_HOST_PATH=/etc/fail2ban-dashboard/htpasswd
# The certificate used here must include both petsanything.com and
# www.petsanything.com in subjectAltName when CANONICAL_REDIRECT_NAMES
# contains the www host; TLS validation happens before the 301 redirect.
# Static frontend proxies /api, /ws, and /uploads to the backend service.
# Use the internal backend or gateway origin that the edge container can reach.
BACKEND_ORIGIN=http://backend.internal.example:8081
CLIENT_MAX_BODY_SIZE=6m
# Space-separated extra Content-Security-Policy connect-src origins for absolute runtime-config.js API/WS URLs.
# Example: CSP_EXTRA_CONNECT_SRC=https://api.example.com wss://api.example.com
CSP_EXTRA_CONNECT_SRC=
